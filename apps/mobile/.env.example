# Copy to .env.local. Expo inlines EXPO_PUBLIC_ values into the app bundle, so only public values go here.

# The Supabase project and its publishable key. Without them, a voice press says "Voice is unavailable".
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Development builds only: scripted phrases instead of the mic and OpenAI, for the Mac simulator check.
# EXPO_PUBLIC_VOICE_STUB=strike swinging|strike
