{
  "name": "@sandlot/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@sandlot/engine": "workspace:*",
    "@sandlot/tokens": "workspace:*",
    "expo": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-sqlite": "~58.0.13",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@types/node": "22.20.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-styles.mjs",
    "test": "node scripts/lint-styles.mjs && expo export --platform web --dev --output-dir dist-web && node --experimental-strip-types --test test/*.test.mjs test/offline-game.test.ts",
    "bundle": "expo export --platform ios --platform android --output-dir dist"
  },
  "private": true,
  "type": "module"
}
