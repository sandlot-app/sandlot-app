{
  "name": "@sandlot/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@sandlot/engine": "workspace:*",
    "@sandlot/tokens": "workspace:*",
    "@sandlot/voice": "workspace:*",
    "@supabase/supabase-js": "2.117.3",
    "expo": "~58.0.17",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-media-library": "~58.0.12",
    "expo-router": "~58.0.25",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-styles.mjs && expo lint",
    "test": "node scripts/lint-styles.mjs && expo export --platform web --dev --output-dir dist-web && node --experimental-strip-types --test test/*.test.mjs test/offline-game.test.ts test/game-share.test.ts test/voice-press.test.ts test/voice-outcome.test.ts test/voice-controller.test.ts test/voice-warm-mic.test.ts test/matchup-line.test.ts test/play-log.test.ts test/sync-store.test.ts test/sync-upload.test.ts test/server-game.test.ts test/sync-runner.test.ts test/sync-line.test.ts test/identity.test.ts test/voice-loop.test.ts",
    "bundle": "expo export --platform ios --platform android --output-dir dist",
    "demo-pins": "node --experimental-strip-types scripts/demo-pins.ts",
    "voice-loop": "node --experimental-strip-types scripts/voice-loop/loop.ts",
    "voice-batch": "node --experimental-strip-types scripts/voice-loop/batch.ts"
  },
  "private": true,
  "type": "module"
}
